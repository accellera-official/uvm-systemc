# - Config file for the UVMSystemC package
#
# Provides the imported target:
#   UVMSystemC::uvm-systemc  — the UVM-SystemC library
#
# The following variables are also set for informational purposes:
#   UVMSystemC_TARGET_ARCH    — target architecture used at build time
#   UVMSystemC_VERSION_STRING — complete UVM-SystemC version string

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# UVM-SystemC requires SystemC.
find_dependency(SystemCLanguage 2.3 CONFIG REQUIRED)

# Re-find PCRE when that regular-expression backend was selected at build time.
if (@UVM_SYSTEMC_PCRE_ENABLED@)
  find_dependency (PkgConfig REQUIRED)
  pkg_check_modules (PCRE REQUIRED IMPORTED_TARGET libpcreposix libpcre)
endif ()

include ("${CMAKE_CURRENT_LIST_DIR}/UVMSystemCTargets.cmake")

set (UVMSystemC_TARGET_ARCH @UVMSystemC_TARGET_ARCH@)
set (UVMSystemC_VERSION_STRING "@UVMSystemC_VERSION_STRING@")

check_required_components (UVMSystemC)
